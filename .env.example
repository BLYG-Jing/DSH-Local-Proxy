# Copy this file to .env only for local tooling that loads dotenv files.
# server.js itself reads process environment variables and does not load .env.

LISTEN_HOST=127.0.0.1
LISTEN_PORT=18082
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=18080
HISTORY_READ_TIMEOUT_MS=120000

# Public-link transport optimization; set either switch to 0 for immediate rollback.
RESPONSE_COMPRESSION=1
COMPRESSION_THRESHOLD_BYTES=1024
MAX_PATCHED_RESPONSE_BYTES=2097152
IMMUTABLE_STATIC_CACHE=1

AUTH_PASSWORD=replace-with-a-long-random-password
